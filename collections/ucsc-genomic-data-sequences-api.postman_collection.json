          "name": "Get DNA Sequence",
          "request": {
            "name": "Get DNA Sequence",
            "description": {
              "content": "Retrieves a DNA sequence from a genome assembly for a specified genomic region.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "getData",
                "sequence"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "genome",
                  "value": "<string>",
                  "description": "(Required) Genome assembly identifier (e.g., hg38, mm39)."
                },
                {
                  "disabled": false,
                  "key": "chrom",
                  "value": "<string>",
                  "description": "(Required) Chromosome identifier (e.g., chr1, chrM)."
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<integer>",
                  "description": "Start position (0-based, half-open coordinates)."
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<integer>",
                  "description": "End position (1-based, half-open coordinates)."
                },
                {
                  "disabled": false,
                  "key": "revComp",
                  "value": "<integer>",
                  "description": "Set to 1 to return the reverse complement sequence."
                },
                {
                  "disabled": false,
                  "key": "hubUrl",
                  "value": "<uri>",
                  "description": "URL of the hub.txt file for a sequence hub."
                }
              ],
              "variable": []
            },
