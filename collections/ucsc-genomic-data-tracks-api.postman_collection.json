                  "description": "(Required) Genome assembly identifier (e.g., hg38, mm39). Required unless hubUrl is provided."
                },
                {
                  "disabled": false,
                  "key": "hubUrl",
                  "value": "<uri>",
                  "description": "URL of the hub.txt file for a track hub."
                },
